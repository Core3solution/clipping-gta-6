# Copy to .env (never commit .env). Values are read by `python3 -m clipper`.
# Telegram: create the bot with @BotFather, send it any message, then run
#   python3 -m clipper --profile gta-br telegram chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Default profile for every command (so you can omit --profile gta-br)
CLIPPER_PROFILE=gta-br
# One MP4 per video (the best-ranked hook) instead of one per hook variant
CLIPPER_TOP_HOOKS=1
